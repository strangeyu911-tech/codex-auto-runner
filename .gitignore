# TypeScript sidecar output emitted beside source during local checks
apps/**/src/**/*.js
apps/**/src/**/*.js.map
apps/**/src/**/*.d.ts
apps/**/src/**/*.d.ts.map
packages/**/src/**/*.js
packages/**/src/**/*.js.map
